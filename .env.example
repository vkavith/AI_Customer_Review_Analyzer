# Copy this file to .env and fill in your values. NEVER commit the real .env.

# Which provider to use: "groq" (active) or "openai" (fallback)
ACTIVE_PROVIDER=groq

# Groq (active) - get a free key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI (optional fallback - keep commented unless you switch providers)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Postgres connection
DATABASE_URL=postgresql+psycopg://localhost:5432/review_analyzer

# Embedding model (runs locally, free)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval settings
TOP_K=4
