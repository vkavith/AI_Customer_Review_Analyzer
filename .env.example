# Copy this file to .env and fill in your values. NEVER commit the real .env.

# LLM provider
ACTIVE_PROVIDER=openai

# OpenAI - get a key at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Postgres connection
DATABASE_URL=postgresql+psycopg://localhost:5432/review_analyzer

# Embedding model (runs locally, free)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval settings
TOP_K=4
